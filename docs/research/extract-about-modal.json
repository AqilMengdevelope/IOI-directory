{"html":"<div class=\"modal-layer\" role=\"dialog\" aria-modal=\"true\" aria-label=\"What’s GMBB?\"><button class=\"modal-backdrop\" aria-label=\"Close\" tabindex=\"-1\"></button><div class=\"modal about-modal\"><div class=\"modal-head\"><strong>What’s GMBB?</strong><button class=\"icon-button\" aria-label=\"Close\"><svg/></button></div><img class=\"gmbb-photo\" alt=\"GMBB building\" src=\"/maps/gmbb/gmbb-building.webp\"><p class=\"modal-body\">GMBB is a creative community mall on Jalan Robertson in Bukit Bintang, Kuala Lumpur. Instead of typical retail brands, it’s an enterprising hub and artistic space that brings together Malaysian artists, independent creators and artisanal enterprises.</p><div class=\"modal-actions gmbb-actions\"><a class=\"primary-button\" href=\"https://www.google.com/maps/dir/?api=1&amp;destination=GMBB%2C%202%20Jalan%20Robertson%2C%2050150%20Kuala%20Lumpur\" target=\"_blank\" rel=\"noopener noreferrer\"><svg/>Get directions</a><a class=\"quiet-button\" href=\"https://gmbb.com.my/\" target=\"_blank\" rel=\"noopener noreferrer\"><svg/>Website</a></div></div></div>","boxes":[{"cls":"modal-layer","w":1440,"h":876,"x":0,"y":0,"pad":"20px","radius":"0px","bg":"rgba(0, 0, 0, 0)","bgi":"none","shadow":"none","font":"400 16px/24px Nunito","color":"rgb(12, 13, 15)","anim":"none"},{"cls":"modal-backdrop","w":1440,"h":876,"x":0,"y":0,"pad":"0px","radius":"0px","bg":"rgba(16, 19, 23, 0.333)","bgi":"none","shadow":"none","font":"400 16px/24px Nunito","color":"rgb(12, 13, 15)","anim":"none"},{"cls":"modal about-modal","w":392,"h":529,"x":524,"y":174,"pad":"20px","radius":"22px","bg":"rgba(250, 250, 248, 0.9)","bgi":"none","shadow":"rgba(21, 32, 43, 0.14) 0px 22px 52px 0px, rgb(255, 255, 255) 0px 1px 0px 0px inset","font":"400 16px/24px Nunito","color":"rgb(12, 13, 15)","anim":"pop-in"},{"cls":"modal-head","w":350,"h":41,"x":545,"y":195,"pad":"6px 30px 0px","radius":"0px","bg":"rgba(0, 0, 0, 0)","bgi":"none","shadow":"none","font":"400 16px/24px Nunito","c